<?xml version="1.0" encoding="utf-8"?>
<!-- Reporte de ventas: totales, ventas por categoría y productos más vendidos -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/Text.IronMarket.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reporte de ventas" />

        <TextView
            style="@style/Text.IronMarket.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Octubre y noviembre de 2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="?attr/colorPrimary"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_bold"
                android:text="Ventas totales"
                android:textColor="@color/im_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/totalSales"
                style="@style/Text.IronMarket.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/im_ink"
                android:textSize="40sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <include
                android:id="@+id/statOrders"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1" />

            <include
                android:id="@+id/statTicket"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.IronMarket.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Ventas por categoría" />

        <LinearLayout
            android:id="@+id/categoryBars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_l" />

        <TextView
            style="@style/Text.IronMarket.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Productos más vendidos" />

        <LinearLayout
            android:id="@+id/topProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
