<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del comprador: ubicación, búsqueda, categorías, banner y más vendidos -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    style="@style/Text.IronMarket.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola" />

                <TextView
                    style="@style/Text.IronMarket.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/barlow_bold"
                    android:text="Chapinero, Bogotá"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notificationsButton"
                style="@style/Widget.IronMarket.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Notificaciones"
                app:icon="@drawable/ic_bell" />
        </LinearLayout>

        <!-- Buscador: al tocarlo abre el catálogo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:hint="@string/search_hint"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- Banner de equipo usado cerca (geolocalización) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nearbyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.IronMarket.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Equipo usado cerca de ti"
                        android:textColor="@color/im_ink"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semibold"
                        android:text="Vendedores a menos de 5 km. Recoge hoy y ahorra el envío."
                        android:textColor="@color/im_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/im_ink"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding">

            <TextView
                style="@style/Text.IronMarket.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/best_sellers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeAllButton"
                style="@style/Widget.IronMarket.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bestSellersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
