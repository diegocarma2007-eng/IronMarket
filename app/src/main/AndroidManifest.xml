<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometría para ingreso con huella y confirmación de pagos -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- La cámara es opcional: la app funciona en equipos sin cámara -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IronMarket"
        tools:targetApi="34">

        <!-- Transversal -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.IronMarket.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RegisterActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RecoverPasswordActivity" />

        <!-- Comprador -->
        <activity android:name=".ui.buyer.BuyerActivity" />
        <activity android:name=".ui.buyer.ProductDetailActivity" />
        <activity android:name=".ui.buyer.CheckoutActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Vendedor -->
        <activity android:name=".ui.seller.SellerActivity" />
        <activity android:name=".ui.seller.ProductFormActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Administrador -->
        <activity android:name=".ui.admin.AdminActivity" />
        <activity android:name=".ui.admin.UserFormActivity" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
