rules_version = '2';
// Reglas de Firebase Storage: imágenes de productos.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{file} {
      allow read: if true;   // las imágenes del catálogo son públicas
      // Solo usuarios autenticados suben imágenes JPEG de máximo 2 MB
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
